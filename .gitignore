.DS_Store
*.tvm

# Playwright MCP scratch dir (occasionally created by tooling)
.playwright-mcp/

# Per-image build artifacts (build/<image>/: output, packer_cache,
# drivers/staging — created by `agent-dev-env build`)
build/

# Node (the agent-dev-env CLI in this repo)
node_modules/
.pnpm-store/
dist/

# The CLI package readme — generated from the repo root README.md by
# copy-assets.mjs at build time, so the published npm package ships it.
packages/agent-dev-env-cli/README.md

# Python bytecode
__pycache__/
